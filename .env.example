# Public application configuration only. Do not add real credentials to this file.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Health API OAuth 2.0 Web Application Credentials
# Register Redirect URI in Google Cloud Console: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
