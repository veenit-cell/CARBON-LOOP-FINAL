{
  "name": "@carbonloop/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "//prebuild": "The `@carbonloop/*` exports maps point at ./dist, which is gitignored. Hosts that treat apps/web as the root directory (Vercel does) run this script's `build` directly, so the repo-root prebuild never fires and every workspace import fails to resolve on a fresh clone. Hooking it here covers both entry points.",
    "prebuild": "npm run build:packages --prefix ../..",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib next.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@carbonloop/carbon-engine": "0.1.0",
    "@carbonloop/factor-registry": "0.1.0",
    "@carbonloop/marketplace": "0.1.0",
    "@carbonloop/quest-engine": "0.1.0",
    "@carbonloop/schemas": "0.1.0",
    "@carbonloop/scoring": "0.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
